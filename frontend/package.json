{
  "name": "inti-wasi-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "node --env-file=.env.build ./node_modules/@angular/cli/bin/ng.js",
    "start": "npm run ng -- serve",
    "build": "npm run ng -- build",
    "watch": "npm run ng -- build --watch --configuration development",
    "test": "npm run ng -- test",
    "test:e2e": "node e2e/login.cjs",
    "test:e2e:playwright": "playwright test"
  },
  "private": true,
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "@angular/cdk": "^22.2.0",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/material": "^22.2.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "postcss": "^8.5.28",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.0",
    "@axe-core/playwright": "^4.13.0",
    "@oxc-parser/binding-wasm32-wasi": "0.150.0",
    "@playwright/cli": "^0.1.22",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.1",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "selenium-webdriver": "^4.50.0",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "@napi-rs/wasm-runtime": "1.2.1"
  }
}
