        <mxCell id="legend_d" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#29445A;fontStyle=0;spacing=0;" value="Tarjetas: métodos principales verificados; se omiten DTO, accesores Lombok, métodos heredados y sobrecargas para mantener la lectura clara.&lt;div&gt;&lt;br&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(41, 68, 90), rgb(163, 186, 205));&quot;&gt;Las cardinalidades 1, 0..1, 0..*&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(41, 68, 90), rgb(163, 186, 205));&quot;&gt; y 1..&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(41, 68, 90), rgb(163, 186, 205));&quot;&gt;*&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(41, 68, 90), rgb(163, 186, 205));&quot;&gt; representan las reglas de negocio aplicadas por el backend.&lt;/span&gt;&lt;div&gt;&lt;p&gt;&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="50" width="950.5" x="73" y="2604" as="geometry" />
