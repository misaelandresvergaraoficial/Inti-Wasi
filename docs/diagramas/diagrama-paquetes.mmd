  classDef backend fill:#eaf5ee,stroke:#54866a,color:#214b35,rx:10,ry:10;
  classDef datos fill:#fff4df,stroke:#ac8336,color:#624814,rx:10,ry:10;
  class actor usuario;
  class acceso,catalogos,operaciones,consultas frontend;
  class seguridad,api,negocio,persistencia backend;
  class maestros,compras,inventario,automatizacion datos;
